# Regras da página estática. Este arquivo vale só para esta pasta.
# O WordPress continua mandando no resto do site, com o .htaccess dele na raiz.

# ---------------------------------------------------------------- tipos
# O Apache da hospedagem pode não conhecer AVIF; sem isto o navegador recebe
# octet-stream e o formato moderno é descartado.
<IfModule mod_mime.c>
  AddType image/avif             .avif
  AddType image/webp             .webp
  AddType font/woff2             .woff2
  AddType image/svg+xml          .svg
  AddType text/javascript        .js
</IfModule>

# ---------------------------------------------------------------- compressão
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript image/svg+xml
</IfModule>

# ---------------------------------------------------------------- cache
# Imagens e fontes ficam um ano no cache, e por isso **o nome do arquivo tem
# que mudar quando o conteúdo muda** — é o que o script de imagens faz ao
# gerar larguras novas. Se algum dia trocar o conteúdo mantendo o nome, o
# visitante antigo continua vendo a imagem velha por um ano.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/avif       "access plus 1 year"
  ExpiresByType image/webp       "access plus 1 year"
  ExpiresByType image/png        "access plus 1 year"
  ExpiresByType image/svg+xml    "access plus 1 year"
  ExpiresByType font/woff2       "access plus 1 year"
  ExpiresByType text/css         "access plus 0 seconds"
  ExpiresByType text/javascript  "access plus 0 seconds"
  ExpiresByType text/html        "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(avif|webp|png|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # HTML, CSS e JS revalidam a cada visita. Sem etapa de build os nomes de
  # arquivo são fixos, então guardar por uma semana faz o visitante que já
  # esteve aqui receber HTML novo com CSS velho — a página quebra inteira.
  # O 304 de revalidação custa alguns bytes e vale a garantia.
  <FilesMatch "\.(html|css|js)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

Options -Indexes
